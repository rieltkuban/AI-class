# Режим сайта: teaser — экраны 0–2 и форма; full — все семь состояний (ТЗ, 1.4)
SITE_MODE=teaser

# Yandex Cloud. Базовый URL проверяется пробным запросом (ТЗ, 3.3) — не угадывать.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=
# openai — основной путь, native — запасной с кумулятивными чанками (ТЗ, 3.2)
LLM_TRANSPORT=openai
MODEL_MAIN=
MODEL_OPPONENT=

# Заявки уходят в Telegram, дубликат пишется в LEADS_FILE (ТЗ, 1.1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEADS_FILE=/var/www/aiclass/data/leads.jsonl

# Счётчик мест. Только ручное значение, автоуменьшение запрещено (ТЗ, 1.2)
SEATS_TOTAL=8
SEATS_TAKEN=0
ADMISSION_OPEN=true

# Дата открытия доступа для текстов тизера
LAUNCH_DATE=

# Лимиты (ТЗ, 8)
RATE_LIMIT_RUNS_PER_HOUR=3
RATE_LIMIT_RUNS_PER_DAY=10

# Яндекс.Метрика
METRIKA_ID=

# Собственный API Yandex (запасной путь). По умолчанию https://llm.api.cloud.yandex.net
YANDEX_NATIVE_URL=
