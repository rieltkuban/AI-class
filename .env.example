# Скопировать в .env.production на сервере, права 600, владелец www-data.
# Файл лежит вне git. Ключи в репозиторий не попадают никогда.

# ── Режим сайта (ТЗ, 1.4) ──────────────────────────────────────────────
# teaser — экраны 0–2 и форма контакта; full — все семь состояний.
SITE_MODE=teaser

# ── Модель ─────────────────────────────────────────────────────────────
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Базовый URL OpenAI-совместимого эндпоинта Yandex AI Studio.
# ПРОВЕРЯЕТСЯ ПРОБНЫМ ЗАПРОСОМ (scripts/probe.ts), не угадывать (ТЗ, 3.3).
YANDEX_BASE_URL=

# openai — основной путь (SSE, дельты); native — запасной (кумулятивные чанки).
LLM_TRANSPORT=openai

# Хост собственного API Yandex для запасного пути.
# Пусто — берётся https://llm.api.cloud.yandex.net
YANDEX_NATIVE_URL=

# Имена моделей. Значений по умолчанию код не подставляет.
# Оппонент запускается на модели другого класса (ТЗ, 6.2).
MODEL_MAIN=
MODEL_OPPONENT=

# ── Заявки (ТЗ, 1.1) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Дубликат каждой заявки одной строкой. Это не база, а страховка.
LEADS_FILE=/var/www/aiclass/data/leads.jsonl

# ── Счётчик мест (ТЗ, 1.2) ─────────────────────────────────────────────
# Только ручное значение. Автоматическое уменьшение по таймеру запрещено.
SEATS_TOTAL=8
SEATS_TAKEN=0
ADMISSION_OPEN=true

# Дата открытия доступа, как она должна выглядеть на экране.
LAUNCH_DATE=

# ── Лимиты (ТЗ, 8) ─────────────────────────────────────────────────────
RATE_LIMIT_RUNS_PER_HOUR=3
RATE_LIMIT_RUNS_PER_DAY=10

# ── Аналитика ──────────────────────────────────────────────────────────
# Номер счётчика Яндекс.Метрики. Префикс NEXT_PUBLIC_ обязателен:
# счётчик работает в браузере. Это не секрет.
NEXT_PUBLIC_METRIKA_ID=

# ── SEO ────────────────────────────────────────────────────────────────
# Полный адрес сайта, например https://example.ru — нужен для Open Graph.
SITE_URL=
# Индексация. Держать пустым, пока в файлах стоят заглушки «ЗАМЕНИТЬ».
SITE_INDEXABLE=

# ── Где слушает приложение ─────────────────────────────────────────────
PORT=3000
# 127.0.0.1 — прокси на том же хосте.
# 172.18.0.1 — прокси в Docker: это адрес шлюза Docker-сети, наружу
# он не смотрит. Узнать свой: docker network inspect СЕТЬ | grep -i gateway
BIND_HOST=127.0.0.1
