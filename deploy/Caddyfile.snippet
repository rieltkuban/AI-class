# Блок для Caddy. Добавляется в существующий Caddyfile, ничего в нём не ломая.
#
# Зачем это вместо nginx: если на входе сервера уже стоит Caddy, порты 80 и 443
# заняты им. Ставить рядом nginx нельзя — он не сможет их занять. Заодно Caddy
# сам выпускает и продлевает сертификаты Let's Encrypt, так что certbot
# не нужен вообще.
#
# ── Куда проксируем ────────────────────────────────────────────────────
# Приложение живёт на хосте как служба systemd. Если Caddy работает
# в контейнере, до хоста он дотягивается по адресу шлюза Docker-сети.
# Узнать свой:
#     docker network inspect ИМЯ_СЕТИ | grep -i gateway
# Обычно это 172.17.0.1 или 172.18.0.1. Тот же адрес надо прописать
# в BIND_HOST в .env.production, иначе приложение будет слушать 127.0.0.1
# и контейнер до него не достучится.
#
# ЗАМЕНИТЬ: 172.18.0.1 на свой шлюз, домен — на свой.


# ══════════════════════════════════════════════════════════════════════
# ВАРИАНТ 1. Временно, без домена и без сертификата: сайт по IP сервера.
# Открывается как http://IP_СЕРВЕРА. Годится, чтобы просто посмотреть.
# ЗАМЕНИТЬ 203.0.113.10 на IP своего сервера.
# ══════════════════════════════════════════════════════════════════════

http://203.0.113.10 {
	# Поток прогона: flush_interval -1 отключает буферизацию и отдаёт байты
	# сразу, как только они пришли от приложения. Без этого потоковая печать
	# превратится в «страница подумала и выдала текст».
	@stream path /api/run
	handle @stream {
		reverse_proxy 172.18.0.1:3000 {
			flush_interval -1
		}
	}

	# Шрифты и статика Next.js — имена содержат хеш, кэшируем надолго.
	@static path /_next/static/* /fonts/*
	handle @static {
		# Знак > означает «заменить», а не «добавить»: без него к заголовку
		# приложения добавляется второй, и браузер видит два Cache-Control.
		header >Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy 172.18.0.1:3000
	}

	handle {
		reverse_proxy 172.18.0.1:3000
	}
}


# ══════════════════════════════════════════════════════════════════════
# ВАРИАНТ 2. Боевой: свой домен, сертификат Caddy выпустит сам.
# Для выпуска нужна A-запись домена, указывающая на IP этого сервера.
# ══════════════════════════════════════════════════════════════════════

# example.ru, www.example.ru {
# 	encode zstd gzip
#
# 	@stream path /api/run
# 	handle @stream {
# 		reverse_proxy 172.18.0.1:3000 {
# 			flush_interval -1
# 		}
# 	}
#
# 	@static path /_next/static/* /fonts/*
# 	handle @static {
# 		header >Cache-Control "public, max-age=31536000, immutable"
# 		reverse_proxy 172.18.0.1:3000
# 	}
#
# 	handle {
# 		reverse_proxy 172.18.0.1:3000
# 	}
#
# 	log {
# 		output file /data/aiclass.access.log
# 	}
# }


# ── Чего в Caddy нет ───────────────────────────────────────────────────
# Ограничения частоты запросов на уровне прокси (аналога limit_req из nginx)
# в Caddy без плагина нет. Значит, второго рубежа не будет: лимит прогонов
# держит только само приложение — три в час и десять в сутки с одного адреса.
# Для восьми мест этого достаточно, но знать об этом надо.
#
# ── Что Caddy делает правильно сам ─────────────────────────────────────
# X-Forwarded-For он подставляет сам и ИГНОРИРУЕТ заголовок, присланный
# клиентом. Подделать свой адрес и обойти лимит через Caddy нельзя.
# Проверено: пять запросов с разными поддельными адресами легли в один счётчик.
